<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.relieftrack.controller.DispatchController"
      styleClass="page"
      spacing="12">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Dispatch" styleClass="page-title"/>
    <Label text="Follow deployments and keep dispatch actions visible and organized." styleClass="subtitle-text"/>
    <Label fx:id="summaryLabel" text="Loading dispatch data..." styleClass="card-label"/>
</VBox>
