<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.relieftrack.controller.InventoryController"
      styleClass="page"
      spacing="16">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Inventory" styleClass="page-title"/>
    <Label text="Track stock levels and item readiness across all relief hubs." styleClass="subtitle-text"/>
    <Label fx:id="summaryLabel" text="Loading inventory data..." styleClass="card-label"/>

    <HBox spacing="12">
        <TextField fx:id="itemNameField" promptText="Item name" HBox.hgrow="ALWAYS"/>
        <ChoiceBox fx:id="categoryChoice" prefWidth="130"/>
        <DatePicker fx:id="expiryDatePicker" promptText="Expiry date" prefWidth="150"/>
        <ChoiceBox fx:id="warehouseChoice" prefWidth="180"/>
    </HBox>

    <HBox spacing="12">
        <TextField fx:id="quantityField" promptText="Quantity" prefWidth="120"/>
        <TextField fx:id="minimumStockField" promptText="Minimum stock" prefWidth="140"/>
        <Button text="Add Item" onAction="#handleAddInventory" styleClass="quick-action"/>
        <Button text="Update" onAction="#handleUpdateInventory" styleClass="quick-action"/>
        <Button text="Delete" onAction="#handleDeleteInventory" styleClass="quick-action"/>
    </HBox>

    <ListView fx:id="inventoryList" prefHeight="280" styleClass="activity-list"/>
</VBox>
