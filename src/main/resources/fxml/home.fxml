<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.relieftrack.controller.HomeController"
      styleClass="page">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <VBox spacing="4" styleClass="page-header">
        <Label fx:id="pageTitle" text="Operations Dashboard" styleClass="page-title"/>
        <Label text="Monitor relief operations, stock readiness, and dispatch progress in one place."
               styleClass="subtitle-text"/>
    </VBox>

    <HBox spacing="20">

        <VBox styleClass="dashboard-card">
            <Label text="Inventory Items" styleClass="card-label"/>
            <Label fx:id="inventoryCountLabel" text="0" styleClass="card-number"/>
            <Label text="Tracked in the system" styleClass="small-text"/>
        </VBox>

        <VBox styleClass="dashboard-card">
            <Label text="Open Requests" styleClass="card-label"/>
            <Label fx:id="openRequestCountLabel" text="0" styleClass="card-number"/>
            <Label text="Pending or approved" styleClass="small-text"/>
        </VBox>

        <VBox styleClass="dashboard-card">
            <Label text="Warehouses" styleClass="card-label"/>
            <Label fx:id="warehouseCountLabel" text="0" styleClass="card-number"/>
            <Label text="Operational depots" styleClass="small-text"/>
        </VBox>

        <VBox styleClass="dashboard-card">
            <Label text="Dispatch Rate" styleClass="card-label"/>
            <Label fx:id="dispatchRateLabel" text="0%" styleClass="card-number"/>
            <Label text="Against recorded requests" styleClass="small-text"/>
        </VBox>

    </HBox>

    <GridPane hgap="20" vgap="20">

        <columnConstraints>
            <ColumnConstraints percentWidth="65" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
        </columnConstraints>

        <VBox styleClass="panel" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Open Requests" styleClass="section-title"/>

            <TableView fx:id="requestTable" prefHeight="250" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="requestIdColumn" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="requestOrganizationColumn" text="Organization" prefWidth="140"/>
                    <TableColumn fx:id="requestPriorityColumn" text="Priority" prefWidth="100"/>
                    <TableColumn fx:id="requestStatusColumn" text="Status" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="panel" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Critical Alerts" styleClass="section-title"/>

            <ListView fx:id="alertsList" prefHeight="250" styleClass="activity-list"/>
        </VBox>

        <VBox styleClass="panel" spacing="14" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Warehouse Status" styleClass="section-title"/>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" prefHeight="130">
                <VBox fx:id="warehouseStatusContainer" spacing="10"/>
            </ScrollPane>
        </VBox>

        <VBox styleClass="panel" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Quick Actions" styleClass="section-title"/>

            <Button text="Create Inventory Update" onAction="#handleQuickInventory" maxWidth="Infinity" styleClass="quick-action"/>
            <Button text="Review Pending Dispatches" onAction="#handleQuickDispatches" maxWidth="Infinity" styleClass="quick-action"/>
            <Button text="Generate Weekly Report" onAction="#handleQuickReports" maxWidth="Infinity" styleClass="quick-action"/>
        </VBox>

    </GridPane>

</VBox>