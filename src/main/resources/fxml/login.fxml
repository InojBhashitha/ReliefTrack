<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.relieftrack.controller.LoginController"
           stylesheets="@../css/style.css"
           styleClass="login-root">

    <VBox alignment="CENTER" maxWidth="380" maxHeight="440" spacing="18" styleClass="login-card">
        <padding>
            <Insets top="36" right="32" bottom="36" left="32"/>
        </padding>

        <Label text="ReliefTrack" styleClass="app-title"/>

        <VBox spacing="10" maxWidth="Infinity">
            <Label text="Username" styleClass="card-label"/>
            <TextField fx:id="usernameField" promptText="Enter username"/>

            <Label text="Password" styleClass="card-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter password"/>
        </VBox>

        <Button text="Login" onAction="#handleLogin" maxWidth="Infinity" styleClass="login-button-primary"/>
        <Label fx:id="statusLabel" text="" styleClass="status-text" wrapText="true"/>
    </VBox>

</StackPane>