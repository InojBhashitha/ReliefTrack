<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.relieftrack.controller.WarehouseController"
      styleClass="page"
      spacing="16">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Warehouses" styleClass="page-title"/>
    <Label text="Manage storage location status, capacity, and distribution readiness." styleClass="subtitle-text"/>
    <Label fx:id="summaryLabel" text="Loading warehouse data..." styleClass="card-label"/>

    <HBox spacing="12">
        <TextField fx:id="nameField" promptText="Warehouse name" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="districtField" promptText="District" prefWidth="160"/>
        <TextField fx:id="addressField" promptText="Address" HBox.hgrow="ALWAYS"/>
        <Button text="Add Warehouse" onAction="#handleAddWarehouse" styleClass="quick-action"/>
    </HBox>

    <ListView fx:id="warehouseList" prefHeight="280" styleClass="activity-list"/>
</VBox>
